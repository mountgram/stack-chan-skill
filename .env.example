# Brain server variables. StackChan hosts ws://<stackchan>:6001/stacky/device;
# the brain connects out to that device URL.
STACKY_DEVICE_WS_URL=ws://192.168.1.50:6001/stacky/device
STACKY_PUBLIC_BASE_URL=http://192.168.1.100:6001

# Server-selected standby wake word. Firmware must advertise wakeWord support
# before the server arms a local detector.
STACKY_WAKE_WORD_ENABLED=true
STACKY_WAKE_WORD_PHRASE=Stacky
STACKY_WAKE_WORD_MODEL_ID=stacky
# STACKY_WAKE_WORD_MODEL_URL=http://192.168.1.100:6001/models/stacky.json

# Optional LAN/Tailscale proxy. Run this on a LAN machine that can reach StackChan
# and is also on your Tailscale tailnet. Remote brains connect to the proxy URL.
STACKY_PROXY_HOST=0.0.0.0
STACKY_PROXY_PORT=6002
STACKY_PROXY_TARGET_WS_URL=ws://192.168.1.50:6001/stacky/device
